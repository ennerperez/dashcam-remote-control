<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Product>Dashcam Remote Control</Product>
    <AssemblyName>Dashcam.Remote.Control</AssemblyName>
    <RootNamespace>Dashcam.Remote</RootNamespace>
    <ApplicationIcon>Assets\Icons\dashcam-remote-control.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\Icons\*.svg" />
    <AvaloniaResource Include="Assets\Icons\dashcam-remote-control.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Humanizer.Core" Version="3.0.10" />
    <PackageReference Include="LibVLCSharp" Version="3.10.2" />
    <PackageReference Include="LibVLCSharp.Avalonia" Version="3.10.1" />
    <PackageReference Include="Svg.Controls.Avalonia" Version="12.0.0.17" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
  </ItemGroup>
</Project>
